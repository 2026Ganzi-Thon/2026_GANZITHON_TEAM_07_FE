# real (default for `npm run dev`/`build`): sign-up/login/logout/profile and Kakao login use the backend.
#       Counseling, records and malangi are not connected yet and keep using MSW example data per account.
# mock: every request is answered locally by MSW example data (`npm run dev:mock` / `build:mock`).
VITE_API_MODE=real

# real mode only. Leave empty to call the same origin; `npm run dev`/`preview` proxy /api to
# VITE_API_PROXY_TARGET (default: the deployed backend https://malangi.up.railway.app; use
# http://127.0.0.1:8080 for a local backend). For a deployed frontend, set VITE_API_BASE_URL to
# https://malangi.up.railway.app and add the frontend origin to the backend CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=https://malangi.up.railway.app

# Kakao REST API key. The official Kakao button is always shown; without this key it cannot start, and the
# code exchange needs the backend (real mode). The redirect URI must match
# exactly what is registered in the Kakao console AND the backend KAKAO_REDIRECT_URI. Default:
# <current origin>/oauth/callback/kakao. The client secret stays on the backend only.
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=
