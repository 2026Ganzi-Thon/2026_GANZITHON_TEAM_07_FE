# mock: every request is answered locally by MSW example data. No backend requests.
# real: sign-up/login/logout/profile use the backend API. Counseling, records and malangi
#       are not connected yet and keep using MSW example data, separated per real account.
VITE_API_MODE=mock

# real mode only. Leave empty to call the same origin; `npm run dev`/`preview` proxy /api to
# VITE_API_PROXY_TARGET. For a deployed frontend, set the backend origin here and add the
# frontend origin to the backend CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
