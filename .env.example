# real (default for `npm run dev`/`build`): auth, counseling and records use the backend.
#       Toy rendering/audio and preview inventory remain frontend features.
# mock: every request is answered locally by MSW example data (`npm run dev:mock` / `build:mock`).
VITE_API_MODE=real

# Leave empty (or unset) in BOTH local and Vercel builds: requests use same-origin /api.
# vercel.json proxies production/preview deployments to Railway. Do not set the Railway
# URL here: that bypasses the proxy and requires backend CORS changes.
VITE_API_BASE_URL=
# Local Vite dev/preview only; this does not change the destination in vercel.json.
VITE_API_PROXY_TARGET=https://malangi.up.railway.app
